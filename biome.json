{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!apps/server/drizzle",
      "!**/*.gen.ts",
      "!pnpm-lock.yaml",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/desktop/electron-builder.config.mjs",
        "apps/runner/test/mcp-server-test.test.ts",
        "apps/server/test/agent-config-mcp-test.test.ts"
      ],
      "linter": {
        "rules": { "suspicious": { "noTemplateCurlyInString": "off" } }
      }
    },
    {
      "includes": ["apps/**", "packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@agent-rishi/edition-solo": "The Foundation never imports an edition (editions/README.md).",
                  "@agent-rishi/edition-enterprise": "The Foundation never imports an edition (editions/README.md)."
                },
                "patterns": [
                  {
                    "group": ["**/editions/**"],
                    "message": "The Foundation never imports an edition (editions/README.md)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
