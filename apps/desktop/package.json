{
  "name": "@agent-rishi/desktop",
  "version": "0.7.10",
  "private": true,
  "description": "Agent Rishi desktop app: an Electron shell that starts (or attaches to) the Agent Rishi server and loads the same UI.",
  "license": "MIT",
  "author": "sventkrtl",
  "homepage": "https://github.com/sventkrtl/agent-rishi",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsdown && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "package": "node scripts/package.mjs",
    "icons": "python3 ../../scripts/make-icons.py",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2",
    "node-pty": "1.1.0",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@agent-rishi/contracts": "workspace:*",
    "@agent-rishi/providers": "workspace:*",
    "@agent-rishi/runner": "workspace:*",
    "@agent-rishi/server": "workspace:*",
    "@agent-rishi/web": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/ws": "^8.18.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "tsdown": "^0.23.7",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  }
}
